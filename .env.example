# Frontend environment variable
# Leave blank while developing locally.
# For production, use the deployed backend URL.
VITE_API_URL=https://your-deployed-backend.example.com

# Backend environment variables
PORT=5000

MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/

MONGO_DB_NAME=portfolio

EMAIL_USER=your-email@example.com

EMAIL_PASS=your-gmail-app-password

ALLOWED_ORIGINS=http://localhost:5173,https://wadrien-dev.github.io